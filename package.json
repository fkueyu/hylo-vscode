{
  "name": "hylo-html-preview",
  "displayName": "Hylo — HTML Live Preview",
  "description": "实时 HTML 预览与双向联动编辑器，HTML 的 Typora。",
  "version": "0.1.16",
  "publisher": "AINX",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fkueyu/hylo-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/fkueyu/hylo-vscode/issues"
  },
  "homepage": "https://ainx.ink/hylo/",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "hylo.previewMode"
      ]
    }
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "html",
    "preview",
    "live",
    "wysiwyg"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Hylo",
      "properties": {
        "hylo.previewMode": {
          "type": "string",
          "enum": [
            "safe",
            "interactive"
          ],
          "enumDescriptions": [
            "Blocks document scripts and remote resources.",
            "Runs document scripts inside a sandboxed preview frame in trusted workspaces."
          ],
          "default": "safe",
          "scope": "resource",
          "description": "Controls whether Hylo executes document scripts in the isolated preview frame."
        }
      }
    },
    "commands": [
      {
        "command": "hylo.openPreview",
        "title": "%hylo.openPreview%",
        "icon": "$(open-preview)"
      },
      {
        "command": "hylo.exportToPDF",
        "title": "%hylo.exportToPDF%"
      },
      {
        "command": "hylo.exportToWord",
        "title": "%hylo.exportToWord%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == html",
          "command": "hylo.openPreview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == html",
          "command": "hylo.exportToPDF",
          "group": "hylo-export@1"
        },
        {
          "when": "resourceLangId == html",
          "command": "hylo.exportToWord",
          "group": "hylo-export@2"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test test/**/*.test.js test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "bench:core": "node vendor/hylo-core/bench/parse.mjs",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "npx ovsx@0.10.12 publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@ainx/hylo-core": "file:vendor/hylo-core",
    "html-to-docx": "^1.8.0",
    "parse5": "^8.0.1"
  }
}
